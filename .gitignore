# ── Build output ────────────────────────────────────────────────────────────
bin/
obj/
# dist/* not dist/ -- git never descends into an excluded directory, so the
# negation below only works if the contents are excluded rather than the dir.
dist/*
# ...except the mobile userscript: you can't run node on a phone, so it is
# installed from its raw GitHub URL. Generated by tools/build-userscript.js.
!dist/holdonquietly.user.js
# The bookmarklet build must be in the repo too: jsDelivr serves it from here
# (GitHub raw sends text/plain + nosniff, so a browser refuses to run it).
!dist/holdonquietly.boot.js
!dist/bookmarklet.txt
*.user
*.suo
*.cache
.vs/

# ── Bundled third-party ad-blocker (uBlock Origin, GPLv3) ───────────────────
# Not redistributed here — it's an optional local component. See README.
extensions/

# ── Server-side infra (runs on the VPS, not part of the desktop app) ────────
backend/

# ── Internal dev notes (operational details) ───────────────────────────────
HANDOFF.md

# ── Local runtime / staged auto-update artifacts ───────────────────────────
holdonquietly.new.exe
holdonquietly.new.exe.part
hoq-update.cmd
*.log

# ── Local-only secrets/config (never commit) ───────────────────────────────
secrets.local
*.local.json
